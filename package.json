{
  "name": "dsh-texas-poker",
  "version": "1.1.0",
  "type": "module",
  "description": "A playable six-handed no-limit Texas Hold'em table with AI opponents, a coach, session hand history and a profit curve, rendered as a DeepSeek Harness panel.",
  "license": "MIT",
  "author": "garyleelty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garyleelty/dsh-poker.git"
  },
  "homepage": "https://github.com/garyleelty/dsh-poker#readme",
  "bugs": {
    "url": "https://github.com/garyleelty/dsh-poker/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "harness",
    "dsh",
    "dsh-plugin",
    "texas-holdem",
    "poker",
    "game",
    "panel",
    "ai",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "node --check index.js && node --check client.js && node --check lib/table.js && node --check lib/hand.js && node --check lib/ai.js && node --check lib/odds.js && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "meta": {
    "title": "德州扑克",
    "description": "在 Harness 里玩 6 人桌无限注德州扑克，5 个 AI 对手陪桌，可向 AI 教练要建议，并查看会话手牌历史与累计盈亏曲线。"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "CHANGELOG.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
